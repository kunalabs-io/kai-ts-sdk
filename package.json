{
  "name": "@kunalabs-io/kai",
  "version": "0.26.0",
  "license": "Apache-2.0",
  "author": "Kuna Labs <build@kunalabs.io>",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": {
          "import": "./dist/index.d.ts",
          "require": "./dist/index.d.cts"
        },
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist/",
    "src/",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunalabs-io/kai-ts-sdk.git"
  },
  "scripts": {
    "clean": "rm -rf tsconfig.tsbuildinfo ./dist",
    "build": "pnpm clean && pnpm tsdown",
    "watch": "pnpm build --watch",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cetusprotocol/aggregator-sdk": "0.12.1",
    "@mysten/sui": "1.45.0",
    "@opentelemetry/api": "1.9.0",
    "@pythnetwork/pyth-sui-js": "2.1.0",
    "@sinclair/typebox": "^0.33.22",
    "aftermath-ts-sdk": "^1.3.12",
    "bn.js": "^5.2.1",
    "decimal.js": "^10.4.3",
    "lru-cache": "^11.0.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.48.1",
    "@types/bn.js": "^5.1.6",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsdown": "^0.20.3",
    "typescript": "5.6.3",
    "vitest": "^2.1.0"
  }
}
