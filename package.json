{
  "name": "@kunalabs-io/kai",
  "version": "0.30.0",
  "license": "Apache-2.0",
  "author": "Kuna Labs <build@kunalabs.io>",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist/",
    "src/",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunalabs-io/kai-ts-sdk.git"
  },
  "scripts": {
    "clean": "rm -rf tsconfig.tsbuildinfo ./dist",
    "build": "pnpm clean && pnpm tsdown",
    "watch": "pnpm build --watch",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cetusprotocol/aggregator-sdk": "1.6.1",
    "@mysten/sui": "2.20.0",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "@opentelemetry/api": "1.9.1",
    "@pythnetwork/pyth-sui-js": "3.0.0",
    "@sinclair/typebox": "^0.34.49",
    "aftermath-ts-sdk": "2.1.0",
    "bn.js": "^5.2.3",
    "decimal.js": "^10.6.0",
    "lru-cache": "^11.5.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.9",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.13.2",
    "eslint": "^10.5.0",
    "jiti": "2.7.0",
    "prettier": "^3.8.4",
    "tsdown": "^0.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
